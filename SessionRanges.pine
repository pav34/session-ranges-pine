//@version=6
// Session Ranges + Alerts
// Draws the Asia, London and New York session ranges, extends the Asia high
// and low, and alerts when price breaks them after Asia closes.
// Session times are read in the timezone input, so they stay correct through
// daylight-saving changes.
//
// Setup: open the Pine Editor, paste this script, click "Add to chart".
// Alerts: create an alert on this indicator and pick "Any alert() function call",
// or one of the two named conditions.
indicator("Session Ranges + Alerts", "Sessions", overlay = true, max_boxes_count = 300, max_lines_count = 300, max_labels_count = 300)

// ---------- Inputs ----------
G_SES = "Sessions"
tz       = input.string("America/New_York", "Session timezone", group = G_SES, tooltip = "The session times below are read in this timezone.")
asiaOn   = input.bool(true, "", inline = "asia", group = G_SES)
asiaSess = input.session("1800-0300", "Asia", inline = "asia", group = G_SES)
asiaCol  = input.color(color.new(#4C7DFF, 85), "", inline = "asia", group = G_SES)
lonOn    = input.bool(true, "", inline = "lon", group = G_SES)
lonSess  = input.session("0300-0830", "London", inline = "lon", group = G_SES)
lonCol   = input.color(color.new(#F5A524, 85), "", inline = "lon", group = G_SES)
nyOn     = input.bool(true, "", inline = "ny", group = G_SES)
nySess   = input.session("0830-1600", "New York", inline = "ny", group = G_SES)
nyCol    = input.color(color.new(#2BB673, 85), "", inline = "ny", group = G_SES)
showSize = input.bool(true, "Show range size on each box", group = G_SES)

G_LVL = "Asia levels"
extendOn = input.bool(true, "Extend the Asia high and low until the next Asia session", group = G_LVL)
lvlCol   = input.color(#4C7DFF, "Level colour", group = G_LVL)

G_ALR = "Alerts and table"
onClose  = input.bool(true, "Alert only when a candle closes beyond the level", group = G_ALR)
showTbl  = input.bool(true, "Show range table", group = G_ALR)
tblSizeIn = input.string("Large", "Table text size", options = ["Small", "Normal", "Large", "Huge"], group = G_ALR)
tblSize = switch tblSizeIn
    "Small"  => size.small
    "Normal" => size.normal
    "Huge"   => size.huge
    => size.large

// ---------- One session: draws its box while it runs, returns its range ----------
sessionRange(string sess, bool show, color col, string name) =>
    var box   bx = na
    var label lb = na
    var float hi = na
    var float lo = na
    bool inS   = not na(time(timeframe.period, sess, tz))
    bool start = inS and not inS[1]
    if start
        hi := high
        lo := low
        if show
            bx := box.new(bar_index, high, bar_index, low, border_color = color.new(col, 40), bgcolor = col)
            lb := label.new(bar_index, high, name, style = label.style_label_lower_left, color = color(na), textcolor = color.new(col, 0), size = size.small)
    else if inS and not na(hi)
        hi := math.max(hi, high)
        lo := math.min(lo, low)
        if show and not na(bx)
            box.set_right(bx, bar_index)
            box.set_top(bx, hi)
            box.set_bottom(bx, lo)
            label.set_y(lb, hi)
            label.set_text(lb, showSize ? name + "  " + str.tostring(hi - lo, format.mintick) : name)
    [hi, lo, inS, start]

[aHi, aLo, aIn, aStart] = sessionRange(asiaSess, asiaOn, asiaCol, "Asia")
[lHi, lLo, lIn, lStart] = sessionRange(lonSess, lonOn, lonCol, "London")
[nHi, nLo, nIn, nStart] = sessionRange(nySess, nyOn, nyCol, "New York")

// ---------- Asia high and low, extended ----------
var line hiLine  = na
var line loLine  = na
var bool brokeUp = false
var bool brokeDn = false

bool asiaEnded = aIn[1] and not aIn
if aStart
    brokeUp := false
    brokeDn := false
if asiaEnded and extendOn
    hiLine := line.new(bar_index - 1, aHi, bar_index, aHi, color = lvlCol, style = line.style_dashed)
    loLine := line.new(bar_index - 1, aLo, bar_index, aLo, color = lvlCol, style = line.style_dashed)
if not aIn and not na(hiLine)
    line.set_x2(hiLine, bar_index)
    line.set_x2(loLine, bar_index)

// ---------- Breakouts after Asia closes ----------
bool  afterAsia = not aIn and not na(aHi)
float upSrc     = onClose ? close : high
float dnSrc     = onClose ? close : low
bool  breakUp   = afterAsia and not brokeUp and upSrc > aHi
bool  breakDn   = afterAsia and not brokeDn and dnSrc < aLo

if breakUp
    brokeUp := true
    string upMsg = syminfo.ticker + " broke above the Asia high (" + str.tostring(aHi, format.mintick) + ")"
    if onClose
        alert(upMsg, alert.freq_once_per_bar_close)
    else
        alert(upMsg, alert.freq_once_per_bar)
if breakDn
    brokeDn := true
    string dnMsg = syminfo.ticker + " broke below the Asia low (" + str.tostring(aLo, format.mintick) + ")"
    if onClose
        alert(dnMsg, alert.freq_once_per_bar_close)
    else
        alert(dnMsg, alert.freq_once_per_bar)

plotshape(breakUp, "Asia high break", shape.triangleup, location.belowbar, color.new(#2BB673, 0), size = size.tiny)
plotshape(breakDn, "Asia low break", shape.triangledown, location.abovebar, color.new(#F2545B, 0), size = size.tiny)

alertcondition(breakUp, "Break above Asia high", "{{ticker}} broke above the Asia high")
alertcondition(breakDn, "Break below Asia low", "{{ticker}} broke below the Asia low")

// ---------- Range table ----------
rangeText(float hi, float lo) =>
    na(hi) ? "-" : str.tostring(hi - lo, format.mintick)

var table tbl = table.new(position.top_right, 2, 4, bgcolor = color.new(#111827, 5), frame_color = color.new(#2A3446, 0), frame_width = 1, border_color = color.new(#2A3446, 0), border_width = 1)
if showTbl and barstate.islast
    table.cell(tbl, 0, 0, "Session", text_color = color.new(#9AA5B8, 0), text_size = tblSize)
    table.cell(tbl, 1, 0, "Range", text_color = color.new(#9AA5B8, 0), text_size = tblSize)
    table.cell(tbl, 0, 1, "Asia", text_color = color.new(asiaCol, 0), text_size = tblSize)
    table.cell(tbl, 1, 1, rangeText(aHi, aLo), text_color = color.white, text_size = tblSize)
    table.cell(tbl, 0, 2, "London", text_color = color.new(lonCol, 0), text_size = tblSize)
    table.cell(tbl, 1, 2, rangeText(lHi, lLo), text_color = color.white, text_size = tblSize)
    table.cell(tbl, 0, 3, "New York", text_color = color.new(nyCol, 0), text_size = tblSize)
    table.cell(tbl, 1, 3, rangeText(nHi, nLo), text_color = color.white, text_size = tblSize)
